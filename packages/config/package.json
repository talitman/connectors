{
  "name": "@talitman/config",
  "version": "0.1.0",
  "description": "Environment-based configuration loading with zod",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talitman/connectors.git",
    "directory": "packages/config"
  },
  "homepage": "https://github.com/talitman/connectors/tree/main/packages/config#readme",
  "bugs": "https://github.com/talitman/connectors/issues",
  "keywords": [
    "connectors",
    "integration"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@talitman/core": "workspace:*",
    "zod": "4.5.4"
  }
}
