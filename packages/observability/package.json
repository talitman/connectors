{
  "name": "@talitman/observability",
  "version": "0.1.0",
  "description": "Structured logging with secret redaction",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talitman/connectors.git",
    "directory": "packages/observability"
  },
  "homepage": "https://github.com/talitman/connectors/tree/main/packages/observability#readme",
  "bugs": "https://github.com/talitman/connectors/issues",
  "keywords": [
    "connectors",
    "integration"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@talitman/config": "workspace:*",
    "@talitman/core": "workspace:*",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3"
  }
}
